  "narrative": {
    "northStar": "Signal box at night",
    "overview": "Specrails is a dispatch desk for specs travelling down rails to delivery. The chrome is quiet, dense and precise, like a railway signal panel: hairlines, tabular numerals, small status lamps. Colour is spent on lamps (state) and on the moving spec (the brand gradient). The one authored motion is rail travel.",
    "keyCharacteristics": [
      "Dark-first, six themes sharing one token contract.",
      "Hierarchy from a role-based type scale and numerals.",
      "Status is a lamp, never colour alone.",
      "Hairline borders and edge highlights create depth.",
      "System UI sans only; monospace for IDs, code and logs."
    ],
    "rules": [
      {
        "name": "The Lamp Rule",
        "body": "Colour belongs to state. If a hue is not a lamp, the gradient, or the single primary action, it is not on the screen.",
        "section": "colors"
      },
      {
        "name": "The Amber Rule",
        "body": "Amber means caution or cost. Review has its own lamp.",
        "section": "colors"
      },
      {
        "name": "The Gradient Reservation Rule",
        "body": "The cyan-to-violet gradient appears only on the RailMark and the travelling pill.",
        "section": "colors"
      },
      {
        "name": "The Role Rule",
        "body": "Pick a role token, never a raw text-[Npx].",
        "section": "typography"
      },
      {
        "name": "The Numerals Rule",
        "body": "Counts, durations, costs and timestamps use tabular numerals.",
        "section": "typography"
      },
      {
        "name": "The Flat-At-Rest Rule",
        "body": "Resting surfaces get hairline plus shadow 1 at most.",
        "section": "elevation"
      },
      {
        "name": "The No-Halo Rule",
        "body": "Shadows carry an offset and a soft blur; zero-offset halos are limited to code-rain.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the role tokens for type, radius and elevation.",
      "Do express state as a lamp with a label, and reserve amber for caution and cost.",
      "Do show running work as a travelling rail pill and finish with a proportionate arrival moment.",
      "Do keep every text pair at 4.5:1 and every lamp at 3:1 in all six themes.",
      "Do add new copy to all eight locales and new semantic tokens to every [data-theme] block."
    ],
    "donts": [
      "Don't introduce spinners, bouncing dots or a second ping implementation.",
      "Don't use gradient text, glass as decoration, hard offset shadows or coloured side-borders.",
      "Don't pick random radii or shadow-sm to 2xl.",
      "Don't use monospace to look technical or swap the system sans for a decorative face.",
      "Don't colour a status by hue alone."
    ]
  }
