#!/usr/bin/env node
// Scripted engine for the MCP eval harness: a stand-in `claude` CLI that the
// ISOLATED Specrails server (and the Core it runs) finds first on its PATH.
// It never calls a model, so Specrails runs cost $0 and are reproducible.
//
// Behaviour is chosen per invocation by a marker in the prompt (stdin or -p
// argument): `[eval-engine:<mode>]`, else $EVAL_ENGINE_MODE, else `complete`.
//   complete  plays each Core role well enough to finish (architect writes the
//             OpenSpec artifacts through the role's own workflow MCP tool,
//             developer edits one file and ticks tasks, reviewer approves)
//   stall     each Core role streams heartbeats for $EVAL_ENGINE_STALL_S s, then completes (a long run)
//   limit     answers Claude's session-limit message (a provider-limit hold)
//   fail      fails with a provider error (a failed run)
//   question  architect answers with low confidence and one question
// Every invocation is appended to $EVAL_ENGINE_LOG (JSONL) when set.
import fs from 'node:fs'
import path from 'node:path'
import { createRequire } from 'node:module'
import { pathToFileURL } from 'node:url'
import { engineOutput, detectRole, modeOf } from './scripted.mjs'
import { isBuilderTurn } from './builder.mjs'

const args = process.argv.slice(2)
const log = entry => { if (process.env.EVAL_ENGINE_LOG) try { fs.appendFileSync(process.env.EVAL_ENGINE_LOG, JSON.stringify({ at: new Date().toISOString(), cwd: process.cwd(), ...entry }) + '\n') } catch { /* best effort */ } }

const HELP = `Usage: claude [options] [command] [prompt]

Options:
  -p, --print                       Print response and exit
  --output-format <format>          Output format (text, json, stream-json)
  --input-format <format>           Input format (text, stream-json)
  --verbose                         Verbose output
  --model <model>                   Model for the session
  --effort <level>                  Effort level for the session (low, medium, high, xhigh, max)
  --max-turns <n>                   Maximum agentic turns
  --max-budget-usd <amount>         Maximum spend
  --json-schema <schema>            JSON schema for structured output
  --mcp-config <configs...>         Load MCP servers from JSON files or strings
  --strict-mcp-config               Only use MCP servers from --mcp-config
  --allowedTools <tools...>         Tools to allow
  --disallowedTools <tools...>      Tools to deny
  --tools <tools...>                Built-in tools to enable
  --permission-mode <mode>          Permission mode
  --dangerously-skip-permissions    Bypass all permission checks
  --setting-sources <sources>       Setting sources to load
  --append-system-prompt <prompt>   Append a system prompt
  --system-prompt <prompt>          System prompt
  --add-dir <directories...>        Additional directories
  -r, --resume [sessionId]          Resume a conversation
  -c, --continue                    Continue the most recent conversation
  -v, --version                     Output the version number
  -h, --help                        Display help
`
if (args[0] === '--help' || args[0] === '-h') { process.stdout.write(HELP); process.exit(0) }
if (args[0] === '--version' || args[0] === '-v') { console.log('2.1.322 (Claude Code)'); process.exit(0) }
if (args[0] === 'auth' || args[0] === 'doctor' || args[0] === 'mcp' || args[0] === 'config') {
  if (args.includes('--json') || args[1] === 'status') console.log(JSON.stringify({ loggedIn: true, authMethod: 'claude.ai', subscriptionType: 'max', apiProvider: 'firstParty' }))
  process.exit(0)
}
const printMode = args.includes('-p') || args.includes('--print')
if (!printMode) { log({ refused: args.slice(0, 4) }); console.error('eval engine: only print-mode turns are scripted'); process.exit(2) }

const flag = name => { const i = args.indexOf(name); return i >= 0 ? args[i + 1] : undefined }
const pIndex = args.indexOf('-p') >= 0 ? args.indexOf('-p') : args.indexOf('--print')
const inlinePrompt = args[pIndex + 1] && !args[pIndex + 1].startsWith('--') ? args[pIndex + 1] : ''
const stdin = process.stdin.isTTY ? '' : await new Promise(resolve => { let s = ''; process.stdin.setEncoding('utf8'); process.stdin.on('data', d => { s += d }); process.stdin.on('end', () => resolve(s)); process.stdin.on('error', () => resolve(s)) })
const prompt = `${inlinePrompt}\n${stdin}`
let schema
try { schema = flag('--json-schema') ? JSON.parse(flag('--json-schema')) : undefined } catch { schema = undefined }
// A Project Builder turn carries the blueprint-draft contract in its system prompt (or, for providers without one, its prompt).
const systemPrompt = flag('--system-prompt') ?? flag('--append-system-prompt') ?? ''
const role = !schema && isBuilderTurn(`${systemPrompt}\n${prompt}`) ? 'builder' : detectRole(schema)
const mode = modeOf(prompt, process.env.EVAL_ENGINE_MODE)
const session = flag('--resume') ?? `eval-${process.pid}-${Date.now()}`
const stream = flag('--output-format') === 'stream-json'
log({ mode, role, schema: process.env.EVAL_ENGINE_LOG_SCHEMA ? schema : schema ? Object.keys(schema.properties ?? {}) : null, model: flag('--model') ?? null, resume: flag('--resume') ?? null, promptBytes: prompt.length })

const emit = frame => { if (stream) process.stdout.write(JSON.stringify(frame) + '\n') }
emit({ type: 'system', subtype: 'init', session_id: session, model: flag('--model') ?? 'claude-haiku-5-5', tools: [], mcp_servers: [] })

async function finish(effective) {
  const out = await engineOutput({ mode: effective, role, schema, prompt, cwd: process.cwd(), mcpConfig: flag('--mcp-config'), openspecClient, session })
  if (out.stderr) process.stderr.write(out.stderr + '\n')
  if (out.text !== undefined) emit({ type: 'assistant', message: { id: `msg-${session}`, role: 'assistant', content: [{ type: 'text', text: out.text }], usage: { input_tokens: 120, output_tokens: 30 } } })
  const result = { type: 'result', subtype: out.isError ? 'error_during_execution' : 'success', is_error: Boolean(out.isError), num_turns: 1, duration_ms: 5, session_id: session,
    result: out.text ?? '', usage: { input_tokens: 120, output_tokens: 30 }, total_cost_usd: 0, ...(out.structured ? { structured_output: out.structured } : {}) }
  if (stream) emit(result); else process.stdout.write(flag('--output-format') === 'json' ? JSON.stringify(result) : (out.text ?? '') + '\n')
  process.exit(out.exitCode ?? (out.isError ? 1 : 0))
}

if (mode === 'stall' && ['architect', 'developer', 'reviewer'].includes(role)) {
  // A slow step: heartbeats for $EVAL_ENGINE_STALL_S seconds (default 30; 0 = until stopped), then it completes.
  let n = 0
  const beat = () => emit({ type: 'assistant', message: { id: `msg-${session}-${n++}`, role: 'assistant', content: [{ type: 'text', text: `Working (${n})…` }], usage: { input_tokens: 10, output_tokens: 2 } } })
  beat()
  setInterval(beat, 4000)
  const seconds = Number(process.env.EVAL_ENGINE_STALL_S ?? 30)
  if (seconds > 0) setTimeout(() => { void finish('complete') }, seconds * 1000)
  for (const signal of ['SIGTERM', 'SIGINT']) process.on(signal, () => process.exit(143))
} else {
  await finish(mode)
}

/** A client for the role's own OpenSpec workflow server (from --mcp-config), or null. */
async function openspecClient(configFile) {
  if (!configFile) return null
  let config
  try { config = JSON.parse(fs.existsSync(configFile) ? fs.readFileSync(configFile, 'utf8') : configFile) } catch { return null }
  const server = config?.mcpServers?.specrails_openspec
  if (!server?.command) return null
  // The SDK lives in the desktop checkout this harness belongs to.
  const require = createRequire(path.join(path.dirname(new URL(import.meta.url).pathname), '..', '..', '..', 'package.json'))
  const sdk = p => import(pathToFileURL(require.resolve(`@modelcontextprotocol/sdk/${p}`)).href)
  const [{ Client }, { StdioClientTransport }] = await Promise.all([sdk('client/index.js'), sdk('client/stdio.js')])
  const client = new Client({ name: 'eval-engine', version: '1' })
  await client.connect(new StdioClientTransport({ command: server.command, args: server.args ?? [], env: { ...process.env, ...(server.env ?? {}) }, stderr: 'ignore' }))
  return {
    async call(input) {
      const r = await client.callTool({ name: 'workflow', arguments: input })
      const text = r.content?.[0]?.text ?? ''
      if (r.isError) throw new Error(text)
      try { return JSON.parse(text) } catch { return text }
    },
    close: () => client.close(),
  }
}

