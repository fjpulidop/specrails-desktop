node_modules
dist/
cli/dist/
server/dist/
client/dist/
data/

# specrails installer (one-time setup tool, not part of the project)
# Leading slash limits match to root level — without it, the pattern also
# matches .claude/commands/specrails/ which must be tracked.
/specrails/
.claude/worktrees/
coverage/

# Sidecar binaries — built during desktop release, not tracked
src-tauri/binaries/specrails-server-*
src-tauri/binaries/better_sqlite3.node
src-tauri/binaries/pty.node
src-tauri/binaries/node-pty/
src-tauri/binaries/shell-integration/

# Bundled runtimes — populated by CI at build time, not checked in
# The .gitkeep placeholder keeps the directory tracked so Tauri's
# resource glob resolves without error in local development builds.
src-tauri/runtimes/*
!src-tauri/runtimes/.gitkeep

# Bundled specrails-core (offline framework materialize/assemble) —
# populated by CI at build time, not checked in. Mirrors runtimes above.
src-tauri/core/*
!src-tauri/core/.gitkeep

# Bundled @fission-ai/openspec (offline LAST network step of project-add) —
# populated by CI at build time, not checked in. Mirrors core above.
src-tauri/openspec/*
!src-tauri/openspec/.gitkeep

# Sidecar build intermediates (esbuild output + sqlite prebuild cache)
build/

# specrails
.claude/agent-memory/
.specrails/
.tokensave/

# macOS
.DS_Store
